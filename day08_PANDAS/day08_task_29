import pandas as pd

data = {
    "Товар": ["Товар_1", "Товар_2", "Товар_3", "Товар_4", "Товар_5"],
    "Цена": [10, 20, 30, 40, 50 ],
    "Количество": [1, 2, 3, 4, 5],
}

df = pd.DataFrame(data)

df["Стоимость"] = df["Цена"] * df["Количество"]

print(df)
print(df["Цена"].mean())
print(df["Цена"].min())
print(df["Цена"].max())

result = df[df["Цена"] >= 30]
print(result)