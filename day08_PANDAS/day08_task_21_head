import pandas as pd

data = {
    "Имя": ["Анна", "Иван", "Олег"],
    "Баллы": [85, 72, 91]
}

df = pd.DataFrame(data)

df["Группа"] = ["1ИИ-1", "1ИИ-1", "1ИИ-2"]

df["Курс"] = 1
df["Баллы + 5"] = df["Баллы"] + 5

print(df.head())
#`head()` показывает первые строки таблицы. По умолчанию — до пяти строк.
print(df.head(2))
#Так можно попросить показать только первые 2 строки.

# tail() — последние строки
print(df.tail(2))

#info() — краткая информация
df.info()

#dtypes — типы столбцов
print(df.dtypes)

#describe() — простая статистика
print(df.describe())