import matplotlib.pyplot as plt
import pandas as pd

df = pd.read_csv("students.csv")

plt.plot(df["Имя"], df["Баллы"])
plt.title("Баллы студентов")
plt.xlabel("Студент")
plt.ylabel("Баллы")
plt.plot(df["Имя"], df["Баллы"], marker="o")
plt.xticks(rotation=45)
plt.tight_layout()

plt.show()