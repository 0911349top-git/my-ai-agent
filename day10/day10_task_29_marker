import matplotlib.pyplot as plt
import pandas as pd

df = pd.read_csv("students.csv")

#27. Pandas + Matplotlib

result = df.groupby("Группа")["Баллы"].mean().reset_index()

#28. Линейный график
plt.plot(df["Имя"], df["Баллы"])
plt.title("Баллы студентов")
plt.xlabel("Студент")
plt.ylabel("Баллы")

#29. Маркеры на линии
plt.plot(df["Имя"], df["Баллы"], marker="o")
#`marker="o"` добавляет точку на каждое значение.

plt.show()
#Линейный график показывает изменение значений по порядку.